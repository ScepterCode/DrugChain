# DrugChain Backend Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Get these from your Supabase project settings > Database

# Database URL (use connection pooler for production)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Project URL (for Supabase client SDK if needed)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase API Keys
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_NAME=DrugChain API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8001

# ===========================================
# SECURITY
# ===========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ===========================================
# OPTIONAL SERVICES (for future use)
# ===========================================
# MongoDB - for logging (optional)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=drugchain_logs

# Redis - for caching (optional)
REDIS_URL=redis://localhost:6379/0

# Celery - for background tasks (optional)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================================
# BLOCKCHAIN (future implementation)
# ===========================================
FABRIC_NETWORK_URL=grpc://localhost:7051
FABRIC_CHAINCODE_NAME=drugchain
FABRIC_CHANNEL_NAME=drugchain-channel

# ===========================================
# SMS SERVICE (Africa's Talking)
# ===========================================
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=sandbox-api-key
AFRICASTALKING_SENDER_ID=DRUGCHAIN

# ===========================================
# STORAGE
# ===========================================
QR_CODE_STORAGE_PATH=./storage/qr_codes
UPLOAD_MAX_SIZE_MB=10
