# Environment Configuration
APP_NAME=DrugChain API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database - Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.aykzdgvdzmjhwsbjazon:vh1RGEOTKO0d5cKN@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=drugchain_logs

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Blockchain
FABRIC_NETWORK_URL=grpc://localhost:7051
FABRIC_CHAINCODE_NAME=drugchain
FABRIC_CHANNEL_NAME=drugchain-channel

# SMS Gateway (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_SENDER_ID=DRUGCHAIN

# Storage
QR_CODE_STORAGE_PATH=./storage/qr_codes
UPLOAD_MAX_SIZE_MB=10

# CORS
CORS_ORIGINS=https://pack-guard.vercel.app,https://drug-chain.vercel.app,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://localhost:5173,http://localhost:5174

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Set SEND_EMAILS=True to actually send emails
# Leave False to just log email content to console
SEND_EMAILS=False

# SMTP Settings (Gmail example)
# For Gmail: Enable 2FA and create an App Password at:
# https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@packguard.org
MAIL_FROM_NAME=PackGuard
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:5173
