# Environment Configuration
APP_NAME=DrugChain API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database - PostgreSQL
DATABASE_URL=postgresql://drugchain_user:your_password@localhost:5432/drugchain_db

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=drugchain_logs

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Blockchain
FABRIC_NETWORK_URL=grpc://localhost:7051
FABRIC_CHAINCODE_NAME=drugchain
FABRIC_CHANNEL_NAME=drugchain-channel

# SMS Gateway (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_api_key_here
AFRICASTALKING_SENDER_ID=DRUGCHAIN

# Storage
QR_CODE_STORAGE_PATH=./storage/qr_codes
UPLOAD_MAX_SIZE_MB=10

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
